# (Analytics & Logs → HTTP Traffic → Paths). 302, a nie 301, żeby przeglądarka
# nie zapamiętała przekierowania i każde kliknięcie trafiało do Cloudflare.
/cv        /  302
/li        /  302
/ref       /  302
/ref/*     /  302
